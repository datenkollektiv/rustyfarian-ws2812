target/
.embuild
# This is a library crate, so we don't pin the dependencies.
Cargo.lock
# Exception: avr-nano-rainbow is a firmware *binary* package, excluded from the workspace,
# and depends on avr-hal by git (unpublished upstream). Its lockfile is the only thing
# pinning the transitive dependency set, so CI reproducibility requires committing it.
!examples/avr-nano-rainbow/Cargo.lock

.devcontainer

.envrc
.idea/
.claude/
CLAUDE.md
release/
review-queue/
/archive/
/memory/
# Tracking notes for requests filed with other repos; they cite local review queues.
/docs/feature-requests/
audit/
# Bench run artefacts: local serial logs and verdicts, appended on every run.
bench/*/logs/
bench/*/results.jsonl
